rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && incoming().uid == request.auth.uid
        && incoming().email is string
        && incoming().email.size() <= 128;
      allow update: if isOwner(userId)
        && incoming().uid == request.auth.uid
        && incoming().diff(resource.data).affectedKeys().hasOnly(['email', 'role']);
    }

    // 2. Simulations Collection (Publicly readable, admin uploadable)
    match /simulations/{simId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn(); // In a real app, restrict to Admin role
    }

    // 3. Sessions Collection
    match /sessions/{sessionId} {
      function isValidSession(data) {
        return data.sessionId is string 
          && data.userId == request.auth.uid
          && data.simId is string;
      }
      
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidSession(incoming());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid 
        && incoming().diff(resource.data).affectedKeys().hasOnly(['endTime', 'duration', 'status']);

      // 3a. Events Subcollection
      match /events/{eventId} {
        allow read: if isSignedIn(); // Usually only for dashboard
        allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      }
    }

    // 4. Progress Collection
    match /progress/{progressId} {
      allow read: if isSignedIn() && (progressId.startsWith(request.auth.uid) || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
    }
  }
}
