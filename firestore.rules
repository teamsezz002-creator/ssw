rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Since we are interacting mostly from our own backend, 
    // we don't strictly need complex client rules. But we will secure them anyway.
    match /simulations/{simId} {
      // The API server bypasses these rules anyway since it's the Admin SDK. 
      // But we are using the client SDK on the node backend. Wait.
      // If we use the client SDK on the backend without service accounts, we are anonymous!
      // So the backend is accessing as anonymous user! We must allow reads and writes unless we implement Auth.
      allow read, write: if true; 
    }

    match /events/{eventId} {
      // Same here.
      allow read, write: if true;
    }
  }
}
